<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for the Octop Bot macOS client. The same file
  signs the app, the Electron helpers and every binary in the bundled Python
  runtime (electron-builder entitlementsInherit).
-->
<plist version="1.0">
<dict>
  <!-- V8 in Electron and in the Node binary that Playwright's driver runs. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- libffi closures in Python ctypes / cffi extensions. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Python loads extension modules that Octop installs at runtime
       (runtime_packages.py); those are not signed by our team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Voice input (NSMicrophoneUsageDescription). Without it the hardened
       runtime denies the microphone silently. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
