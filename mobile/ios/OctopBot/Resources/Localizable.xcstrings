          }
        }
      }
    },
    "bot.persona": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人设"
          }
        }
      }
    },
    "bot.persona.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who is this Bot and how should it answer?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Bot 是谁，应该怎样回答？"
          }
        }
      }
    },
    "bot.startFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
