{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "history.reauthenticate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to Octop Bot Cloud to recover conversations saved under your Lynxce account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录 Octop Bot 云端，找回这个灵策账号已保存的历史会话。"
          }
        }
      }
    },
    "history.restore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover earlier conversations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找回旧版会话"
          }
        }
      }
    },
    "history.restored": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier conversations are now available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成查找，已找回的会话可在历史中查看。"
          }
        }
      }
    },
    "history.restoreIncomplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some earlier records could not be recovered. You can try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分旧记录暂时无法恢复，可以重试。"
          }
        }
      }
    },
    "history.restoreRetry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery could not finish. Try again in Conversations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话恢复暂未完成，可在会话历史中重试。"
          }
        }
      }
    },
    "credits.scenario.text %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough credits: this step needs about %1$@, you have %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积分不足，这一步需要约 %1$@ 积分，当前 %2$@。"
          }
        }
      }
    },
    "credits.scenario.image %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image needs about %1$@ credits; you have %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作图需要约 %1$@ 积分，余额 %2$@。"
          }
        }
      }
    },
    "credits.scenario.video %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video needs about %1$@ credits; you have %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段视频需要约 %1$@ 积分，余额 %2$@。"
          }
        }
      }
    },
    "credits.scenario.computer %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting the computer needs at least %1$@ credits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机至少需要 %1$@ 积分。"
          }
        }
      }
    },
    "credits.scenario.paused %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out of credits, so the computer is paused. Your files are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积分不足，云电脑已暂停，文件都还在。"
          }
        }
      }
    },
    "error.providerBalance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your API key's balance is too low. Top it up with the provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 API Key 余额不足，请到服务商充值"
          }
        }
      }
    }
,
  "Octop Bot": {
    "shouldTranslate": false
  },
    "bot.chief.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are Chief, the main assistant in Octop Bot. Answer accurately, concisely and warmly, and explain step by step when it helps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是 Chief，Octop Bot 的主助理。回答准确、简洁、友好，需要时分步骤说明。"
          }
        }
      }
    },
    "bot.chief.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your main assistant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的主助理"
          }
        }
      }
    },
    "bot.color": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色"
          }
        }
      }
    },
    "bot.companion.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buddy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小伙伴"
          }
        }
      }
    },
    "bot.companion.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a warm, funny chat buddy. Talk casually like a friend and remember what the user told you in this conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是一个温暖、幽默的聊天伙伴。像朋友一样轻松交流，记住对话里用户说过的事。"
          }
        }
      }
    },
    "bot.companion.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随便聊聊"
          }
        }
      }
    },
    "bot.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Bot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 Bot"
          }
        }
      }
    },
    "bot.delete.confirm %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@? Its conversations stay in your history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除 %@ 吗？它的会话仍保留在历史里。"
          }
        }
      }
    },
    "bot.edit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit look"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改形象"
          }
        }
      }
    },
    "bot.engineer.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Engineer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工程师"
          }
        }
      }
    },
    "bot.engineer.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a senior software engineer. Give runnable code with a brief explanation and call out edge cases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是资深软件工程师。给出可运行的代码和简明解释，指出边界情况。"
          }
        }
      }
    },
    "bot.engineer.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code and debugging"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写代码、排查问题"
          }
        }
      }
    },
    "bot.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字"
          }
        }
      }
    },
    "bot.name.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your Bot a name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给 Bot 起个名字"
          }
        }
      }
    },
    "bot.new": {
      "localizations": {
        "en": {
          "stringUnit": {
