    "bot.researcher.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a researcher. Clarify the question first, then give a well-sourced, clearly structured analysis and point out what is uncertain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是研究员。先澄清问题，再给出有依据、结构清晰的分析，注明不确定之处。"
          }
        }
      }
    },
    "bot.researcher.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Research and analysis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查资料、做分析"
          }
        }
      }
    },
    "bot.shape": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shape"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状"
          }
