    "credits.limit.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lynxce caps Octop Bot's daily usage to prevent runaway spending, and today's cap is used up. It resets at 00:00 UTC; press Continue then to pick up where it stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为防止意外消耗，灵策给 Octop Bot 设了每日用量上限，今天已经用完。北京时间早上 8 点自动恢复，到时点「继续」就接着做。"
          }
        }
      }
    },
