    "bot.translator.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a professional translator. Translate Chinese into natural English and any other language into Chinese, keep the formatting, and output only the translation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是专业翻译。中文译成地道英文，其他语言译成中文，保留格式，只输出译文。"
          }
        }
      }
    },
    "bot.translator.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
