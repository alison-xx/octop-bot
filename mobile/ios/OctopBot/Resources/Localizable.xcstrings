{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Octop Bot": {
      "shouldTranslate": false
    },
    "bot.chief.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are Chief, the main assistant in Octop Bot. Answer accurately, concisely and warmly, and explain step by step when it helps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是 Chief，Octop Bot 的主助理。回答准确、简洁、友好，需要时分步骤说明。"
          }
        }
      }
    },
    "bot.chief.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your main assistant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的主助理"
          }
        }
      }
    },
    "bot.color": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色"
          }
        }
      }
    },
    "bot.companion.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buddy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小伙伴"
          }
        }
      }
    },
    "bot.companion.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a warm, funny chat buddy. Talk casually like a friend and remember what the user told you in this conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是一个温暖、幽默的聊天伙伴。像朋友一样轻松交流，记住对话里用户说过的事。"
          }
        }
      }
    },
    "bot.companion.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随便聊聊"
          }
        }
      }
    },
    "bot.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Bot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 Bot"
          }
        }
      }
    },
    "bot.delete.confirm %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@? Its conversations stay in your history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除 %@ 吗？它的会话仍保留在历史里。"
          }
        }
      }
    },
    "bot.edit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit look"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改形象"
          }
        }
