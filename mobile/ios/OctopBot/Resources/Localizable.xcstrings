    "bot.engineer.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a senior software engineer. Give runnable code with a brief explanation and call out edge cases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是资深软件工程师。给出可运行的代码和简明解释，指出边界情况。"
          }
        }
      }
    },
    "bot.engineer.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code and debugging"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写代码、排查问题"
          }
        }
      }
    },
