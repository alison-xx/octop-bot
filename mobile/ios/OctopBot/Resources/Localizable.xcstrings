            "value": "Getting ready…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备中…"
          }
        }
      }
    },
    "bot.preparingChat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Bot is getting ready…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot 正在准备，稍等片刻"
          }
        }
      }
    },
    "bot.researcher.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Researcher"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "研究员"
          }
        }
      }
    },
    "bot.researcher.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a researcher. Clarify the question first, then give a well-sourced, clearly structured analysis and point out what is uncertain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是研究员。先澄清问题，再给出有依据、结构清晰的分析，注明不确定之处。"
          }
        }
      }
    },
    "bot.researcher.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Research and analysis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查资料、做分析"
          }
        }
      }
    },
    "bot.shape": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shape"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状"
          }
        }
      }
    },
    "bot.shuffle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surprise me"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随机换个样子"
          }
        }
      }
    },
    "bot.translator.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translator"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译官"
          }
        }
      }
    },
    "bot.translator.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a professional translator. Translate Chinese into natural English and any other language into Chinese, keep the formatting, and output only the translation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是专业翻译。中文译成地道英文，其他语言译成中文，保留格式，只输出译文。"
          }
        }
      }
    },
    "bot.translator.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中英互译"
          }
        }
      }
    },
    "bot.writer.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写作助手"
          }
        }
      }
    },
    "bot.writer.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a writing assistant. Help draft, polish and rewrite text in a natural voice that fits the style the user wants."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是写作助手。帮用户起草、润色和改写文字，语气自然，贴合用户要的风格。"
          }
        }
      }
    },
    "bot.writer.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drafting and editing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起草与润色"
          }
        }
      }
    },
