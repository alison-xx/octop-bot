    "bot.researcher.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Researcher"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "研究员"
          }
        }
      }
