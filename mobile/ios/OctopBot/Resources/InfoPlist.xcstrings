{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "CFBundleDisplayName": {
      "shouldTranslate": false
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Octop Bot checks your calendar and, after you confirm, adds or changes events your Bots plan for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Octop Bot 查看你的日历，并在你确认后添加或修改 Bot 为你安排的日程。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Octop Bot listens when you talk to your Bots."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和 Bot 语音对话时需要使用麦克风。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Octop Bot checks your reminders and, after you confirm, adds the to-dos your Bots find for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Octop Bot 查看你的提醒事项，并在你确认后添加 Bot 为你整理的待办。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Octop Bot turns what you say into text when your account has no speech service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号没有语音识别服务时，Octop Bot 会在本机把你说的话转成文字。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Octop Bot connects to your own Octop server on this network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Octop Bot 需要连接你在本地网络中的 Octop 服务器。"
          }
        }
      }
    }
  }
}