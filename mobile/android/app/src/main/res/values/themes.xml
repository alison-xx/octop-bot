<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight so AppCompatDelegate.setDefaultNightMode drives the in-app appearance setting. -->
    <style name="Theme.OctopBot" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- System splash (Android 12+ and the core-splashscreen backport): the launch art on the launch background,
         kept only until the first frame; the first Compose screen then draws the same art in the same place. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_art</item>
        <item name="postSplashScreenTheme">@style/Theme.OctopBot</item>
    </style>
</resources>
